# Copy to .env.local (git-ignored). Same names go in Vercel → Project → Settings → Environment Variables.

# Contact form delivery (app/api/contact/route.ts) — sent through Resend.
RESEND_API_KEY=
CONTACT_TO=            # mailbox that receives quote and service requests; comma-separate for several
CONTACT_FROM=          # must be on a domain verified in Resend, e.g. "Arab Lab Website <website@pioneerpharma-uae.com>"

# Asset pipeline (scripts/assets) — optional, Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
